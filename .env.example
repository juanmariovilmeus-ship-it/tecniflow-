# ==============================================================================
# TECNIFLOW - CONFIGURAÇÕES DO SERVIDOR (.env.example)
# Nunca inclua segredos reais, senhas ou strings de produção neste arquivo.
# Configure as variáveis reais exclusivamente no ambiente seguro do servidor.
# ==============================================================================

# APP_URL: URL pública segura (HTTPS obrigatório) onde a aplicação está hospedada.
# Utilizada para redirecionamentos e callbacks de retorno do checkout.
APP_URL="https://meu-app.run.app"

# DB_PROVIDER: Provedor de banco de dados do backend ("sqlite" ou "postgres").
# Padrão: "sqlite" (utiliza banco local data/tecniflow.db).
# Para ativar o Supabase PostgreSQL persistente, defina: DB_PROVIDER="postgres"
DB_PROVIDER="sqlite"

# DATABASE_URL: Connection string server-only do PostgreSQL (Supabase).
# Obrigatória apenas quando DB_PROVIDER="postgres".
# Conexão recomendada: Supabase Transaction Pooler (porta 6543) com TLS obrigatório.
# Exemplo de formato:
# DATABASE_URL="postgresql://postgres.[REF_PROJETO]:[SUA_SENHA]@aws-0-[REGIAO].pooler.supabase.com:6543/postgres?sslmode=require"
# ATENÇÃO: NUNCA utilize o prefixo VITE_ para esta variável, pois ela é restrita ao backend!
DATABASE_URL=""

# ==============================================================================
# 1. NETLIFY BUILD / VITE FRONTEND (Públicas no bundle do navegador)
# ==============================================================================
# Project URL e Publishable Key para autenticação via Supabase Auth
VITE_SUPABASE_URL="https://aburknnkixeeqpvsyofc.supabase.co"
VITE_SUPABASE_PUBLISHABLE_KEY="sb_publishable_nQu4lm4w3_Zq6a-18FvlsQ_johbNzzx"

# SUPABASE AUTH REDIRECTS (Configurar no Netlify após obter URL pública):
# No ambiente publicado do TecniFlow (ex: https://meu-app.netlify.app), configure:
# VITE_SUPABASE_RESET_REDIRECT_URL="https://meu-app.netlify.app/?auth=recovery"
# VITE_SUPABASE_CONFIRM_REDIRECT_URL="https://meu-app.netlify.app/#auth-callback"
#
# ETAPAS NO PAINEL SUPABASE AUTH (Authentication -> URL Configuration):
# 1. Site URL: https://meu-app.netlify.app
# 2. Redirect URLs (adicionar):
#    - https://meu-app.netlify.app/*
#    - https://meu-app.netlify.app/?auth=recovery
#    - https://meu-app.netlify.app/#auth-callback

# ==============================================================================
# 2. NETLIFY FUNCTIONS / BACKEND SERVERLESS (ESTRITAMENTE PRIVADAS - SEM VITE_)
# ==============================================================================
# Chave de API do Gemini para a Central de Ajuda (/api/help/chat e /api/help/quota)
# NUNCA prefixe com VITE_ e NUNCA exponha no frontend!
GEMINI_API_KEY="SUA_CHAVE_GEMINI_AQUI"
# Modelo utilizado pelo assistente (opcional, padrão: gemini-3.5-flash-lite)
GEMINI_HELP_MODEL="gemini-3.5-flash-lite"

# ==============================================================================
# ==============================================================================
# KIWIFY - MONETIZAÇÃO TECNIFLOW (Server-side / Edge Functions apenas)
# Nesta fase, a cobrança real permanece explicitamente desligada por padrão.
# Para ativar após homologação: KIWIFY_ENABLED="true"
# ATENÇÃO: NUNCA utilize o prefixo VITE_ e NUNCA exponha estas chaves no navegador!
# ==============================================================================

# Habilitar integração de cobrança Kiwify (padrão: false - desligada nesta fase)
KIWIFY_ENABLED="false"

# URL canônica do checkout da Kiwify (HTTPS obrigatório no host pay.kiwify.com.br)
KIWIFY_CHECKOUT_URL="https://pay.kiwify.com.br/Tao519J"

# Segredo de assinatura HMAC-SHA1 do webhook configurado no painel da Kiwify
KIWIFY_WEBHOOK_SECRET="SEU_WEBHOOK_SECRET_AQUI"

# IDs dos produtos autorizados na Kiwify (separados por vírgula)
KIWIFY_ALLOWED_PRODUCT_IDS="fe3f16c0-d5f4-11f1-bd40-b570d8dc84fc"

# KIWIFY_PLAN_ID: Opcional antes da primeira cobrança para este produto único mensal (R$ 49,90/mês).
# O checkout cria o intent com plan_id NULL e o primeiro pagamento assinado fixa o ID do plano atomicamente.
# Pode ser deixado vazio ("") antes do primeiro pagamento.
# Se preenchido com um UUID real, atua como allowlist estrita (rejeita planos divergentes).
# ATENÇÃO: Nunca use valores com reticências '...' (placeholders são rejeitados) e nunca use '1' ou UUID inventado.
KIWIFY_PLAN_ID=""


# ==============================================================================
# MERCADO PAGO - LEGADO (Desativado / Preservado apenas para histórico)
# ==============================================================================
MERCADO_PAGO_ENABLED="false"
MERCADO_PAGO_MODE="test"
MERCADO_PAGO_ACCESS_TOKEN=""
MERCADO_PAGO_WEBHOOK_SECRET=""
MERCADO_PAGO_PLAN_ID=""
MERCADO_PAGO_COLLECTOR_ID=""

# IA desativada por padrão. Ativar somente após confirmar projeto/modelo Free Tier.
HELP_AI_ENABLED=false
